# Copy to .env (gitignored — never commit real values) for local Docker Desktop
# testing with docker-compose.yml. Same variable NAMES the k8s manifests use, so
# promoting to a cluster only ever changes *where the value comes from*
# (this file -> a Secret from CNPG / OpenBao via ExternalSecret), never the app:
#
#   var           local (this file)         AKS
#   -----------   ------------------------  --------------------------------------------
#   DATABASE_URL  postgres://...@db:5432/…  CNPG Secret <cluster>-app key "uri"
#   JWT_SECRET    a throwaway local value   OpenBao kv/user-management-app/jwt via ESO
#   APP_ENV       local                     dev / qa / prod (per overlay patch.yaml)
#   API_HOST      api:8080 (compose DNS)    user-management-app-api:8080 (k8s DNS)

POSTGRES_USER=appuser
POSTGRES_PASSWORD=pw
POSTGRES_DB=user_management_app

# host "db" = the docker-compose service name below, resolved on the compose network
DATABASE_URL=postgres://appuser:pw@db:5432/user_management_app

JWT_SECRET=local-dev-only-not-a-real-secret
APP_ENV=local
