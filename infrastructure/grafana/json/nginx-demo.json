{
  "title": "Nginx Dashboard",
  "uid": "nginx-demo",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheusdatasource" },
        "query": { "query": "label_values(kube_pod_info{pod=~\"nginx-demo-.*\"}, namespace)", "refId": "namespace" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU usage (cores) per pod",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheusdatasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"nginx-demo-.*\", container!=\"\"}[5m])) by (namespace, pod)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory working set (bytes) per pod",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheusdatasource" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"nginx-demo-.*\", container!=\"\"}) by (namespace, pod)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container restarts per pod",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheusdatasource" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"nginx-demo-.*\"}) by (namespace, pod)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    }
  ]
}
